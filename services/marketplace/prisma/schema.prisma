datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

// ── Enums ─────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum PaymentMethod {
  RAZORPAY
  COD
}

// ── Models ────────────────────────────────────────────────────

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique
  farmerId          String      // Auth user ID (cross-service reference)
  supplierId        String      // Supplier profile ID (supplier service)
  supplierUserId    String?     // Supplier's auth user ID (for access checks)
  
  // Items stored as JSON array
  items             Json        // OrderItem[]
  
  // Amounts (in paise for precision — BUG-011 fix)
  subtotalPaise     Int
  taxPaise          Int
  shippingPaise     Int
  totalPaise        Int
  
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(PENDING)
  
  // Razorpay fields (BUG-011 fix: actual payment integration)
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  paidAt            DateTime?
  
  orderStatus       OrderStatus @default(PLACED)
  
  // Shipping
  shippingAddress   Json        // AddressDto
  trackingNumber    String?
  carrier           String?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  
  notes             String?
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  @@index([farmerId])
  @@index([supplierId])
  @@index([supplierUserId])
  @@index([razorpayOrderId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt(sort: Desc)])
}

model CartItem {
  id          String   @id @default(uuid())
  farmerId    String
  productId   String
  supplierId  String
  quantity    Int
  snapshot    Json     // ProductDto snapshot at time of add
  addedAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([farmerId, productId])
  @@index([farmerId])
}

model Review {
  id          String   @id @default(uuid())
  productId   String
  supplierId  String
  farmerId    String
  orderId     String?
  rating      Int      // 1-5
  title       String
  body        String   @db.Text
  isVerified  Boolean  @default(false)
  isFlagged   Boolean  @default(false)
  flagReason  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([productId])
  @@index([supplierId])
  @@index([farmerId])
}

// ── Inquiries & Pre-sale Comm ─────────────────────────────────

enum InquiryStatus {
  OPEN
  RESPONDED
  RESOLVED
  CLOSED
}

model Inquiry {
  id            String          @id @default(uuid())
  productId     String?         // Optional: query about a specific product
  farmerId      String
  supplierId    String          // supplier profile ID
  supplierUserId String?        // supplier's auth user ID (access + notifications)
  subject       String
  body          String          @db.Text
  status        InquiryStatus   @default(OPEN)
  lastMessageAt DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  replies       InquiryReply[]

  @@index([farmerId])
  @@index([supplierId])
  @@index([supplierUserId, lastMessageAt(sort: Desc)])
  @@index([productId])
  @@index([status])
}

model InquiryReply {
  id            String    @id @default(uuid())
  inquiryId     String
  senderId      String    // userId
  senderRole    String    // farmer / supplier
  message       String    @db.Text
  createdAt     DateTime  @default(now())

  inquiry       Inquiry   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
}

// ── Community Buying (Group Deals) ───────────────────────────

model CommunityDeal {
  id              String   @id @default(uuid())
  productId       String
  supplierId      String   // supplier profile ID
  supplierUserId  String?  // supplier's auth user ID (ownership checks)
  title           String
  description     String
  targetQuantity  Int      // Quantity required to unlock discount
  currentQuantity Int      @default(0)
  originalPricePaise Int
  dealPricePaise  Int      // Discounted price
  endsAt          DateTime
  isActive        Boolean  @default(true)
  
  participants    DealParticipant[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId])
  @@index([supplierId])
  @@index([supplierUserId])
  @@index([isActive, endsAt])
}

model DealParticipant {
  id            String         @id @default(uuid())
  dealId        String
  farmerId      String
  quantity      Int
  shippingAddress Json?
  paymentStatus PaymentStatus  @default(PENDING)
  orderId       String?        // Link to final order
  
  deal          CommunityDeal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())

  @@unique([dealId, farmerId])
  @@index([farmerId])
}

model WishlistItem {
  id          String   @id @default(uuid())
  farmerId    String
  productId   String
  supplierId  String
  snapshot    Json     // Product info for quick display
  addedAt     DateTime @default(now())

  @@unique([farmerId, productId])
  @@index([farmerId])
}

// Durable event outbox (see @agrilink/platform). Holds events that could not
// be delivered to Kafka yet, or that were written transactionally.
model OutboxEvent {
  id            String   @id @default(uuid())
  topic         String
  payload       String   @db.Text
  attempts      Int      @default(0)
  lastError     String?
  nextAttemptAt DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([nextAttemptAt])
  @@map("outbox_events")
}
