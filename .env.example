# ==============================================================
# AgriLink — Environment Variables
# cp .env.example .env  and fill in. NEVER commit .env.
# Every service listed here has a free tier / is self-hosted.
# ==============================================================

NODE_ENV=development

# ── Shared secrets (generate each with: openssl rand -hex 32) ─────
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT
COOKIE_SECRET=CHANGE_ME_DIFFERENT_TOO
# Service-to-service key for /*/internal/* routes (never exposed by Nginx)
INTERNAL_API_KEY=CHANGE_ME_INTERNAL

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Set when web + API share a parent domain, e.g. .agrilink.example
COOKIE_DOMAIN=

# ── Databases: Neon free tier (https://neon.tech) or --profile localdb ──
# One database per service. For localdb use host "postgres" (in Docker)
# or "localhost:5433" (from the host).
DATABASE_URL_AUTH=postgresql://USER:PASSWORD@HOST/agrilink_auth?sslmode=require
DATABASE_URL_FARMER=postgresql://USER:PASSWORD@HOST/agrilink_farmer?sslmode=require
DATABASE_URL_SUPPLIER=postgresql://USER:PASSWORD@HOST/agrilink_supplier?sslmode=require
DATABASE_URL_MARKETPLACE=postgresql://USER:PASSWORD@HOST/agrilink_marketplace?sslmode=require
DATABASE_URL_NOTIFICATION=postgresql://USER:PASSWORD@HOST/agrilink_notification?sslmode=require
DATABASE_URL_ML=postgresql://USER:PASSWORD@HOST/agrilink_ml?sslmode=require
# Only for --profile localdb
POSTGRES_PASSWORD=CHANGE_ME

# ── Shared infrastructure (Docker) ─────────────────────────────
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:29092

# ── Service ports (local dev) ─────────────────────────────────
AUTH_PORT=4001
FARMER_PORT=4002
SUPPLIER_PORT=4003
MARKETPLACE_PORT=4004
NOTIFICATION_PORT=4005
ML_PORT=4006
BLOCKCHAIN_PORT=4007

# Service discovery for local dev (Docker overrides these automatically)
AUTH_SERVICE_URL=http://localhost:4001
INTERNAL_AUTH_URL=http://localhost:4001
FARMER_SERVICE_URL=http://localhost:4002
SUPPLIER_SERVICE_URL=http://localhost:4003
MARKETPLACE_SERVICE_URL=http://localhost:4004
NOTIFICATION_SERVICE_URL=http://localhost:4005
BLOCKCHAIN_SERVICE_URL=http://localhost:4007
ML_SERVICE_URL=http://localhost:4006

# ── KYC ────────────────────────────────────────────────────────
# Auto-approve only when Aadhaar and RTC names match exactly. "false" sends
# every submission to the admin queue.
KYC_AUTO_APPROVE=true

# ── Payments: Razorpay test mode (free) ────────────────────────
RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
# Dashboard → Webhooks → URL: https://API_DOMAIN/marketplace/payment/webhook
#   events: payment.captured, order.paid
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# ── Email: any SMTP (Gmail app password: ~500 mails/day free) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=
SMTP_FROM=AgriLink <noreply@example.com>
# Broadcasts go to in-app notifications only unless this is true
BROADCAST_EMAIL=false

# ── SMS: Fast2SMS (optional; leave empty to disable) ────────────
FAST2SMS_API_KEY=

# ── File storage: Cloudinary free tier ─────────────────────────
# Aadhaar/RTC/sketches are stored as PRIVATE assets with signed links.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── ML service ─────────────────────────────────────────────────
# Google Vision: free 1,000 units/month. Put the key file at
# infrastructure/gcp-service-account.json (git-ignored).
GOOGLE_APPLICATION_CREDENTIALS=../../infrastructure/gcp-service-account.json
# Groq free tier (Llama 3) for field extraction
GROQ_API_KEY=

# ── Blockchain: Polygon Amoy testnet (free) ────────────────────
BLOCKCHAIN_NETWORK=amoy            # amoy | localhost | polygon
# Free public RPC; or a free Alchemy/Infura Amoy endpoint for better limits
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology
# Relayer wallet that pays gas. Fund for free: https://faucet.polygon.technology
# Use a dedicated wallet that holds nothing else.
BLOCKCHAIN_ADMIN_PRIVATE_KEY=0xCHANGE_ME
# Filled after: pnpm --filter @agrilink/blockchain deploy:amoy
BLOCKCHAIN_CONTRACT_ADDRESS=
# Optional, free: contract verification on amoy.polygonscan.com
POLYGONSCAN_API_KEY=
# Pinata free tier (1 GB) for agreement documents on IPFS
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

# ── Frontend (baked into the build) ────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_CHANGE_ME
# Shown on /contact
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=

# ── CORS (comma-separated web origins) ─────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Monitoring (docker compose --profile monitoring) ───────────
GRAFANA_PASSWORD=CHANGE_ME
# Where alerts are emailed (defaults to SMTP_USER)
ALERT_EMAIL=

# ── Production edge (docker compose --profile https) ───────────
WEB_DOMAIN=app.example.com
API_DOMAIN=api.example.com
ACME_EMAIL=
